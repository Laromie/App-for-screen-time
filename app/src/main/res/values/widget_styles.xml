<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetText.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WidgetText.Big">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="WidgetText.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#D9FFFFFF</item>
    </style>
</resources>
