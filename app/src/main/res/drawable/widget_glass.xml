<?xml version="1.0" encoding="utf-8"?>
<!-- «Жидкое стекло»: полупрозрачная заливка, блик сверху и светлая кайма. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#14FFFFFF"
                android:startColor="#47FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- мягкий блик в верхней части -->
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.2dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
