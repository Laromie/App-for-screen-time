<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянный фон иконки: полупрозрачная заливка с диагональным градиентом и бликом сверху.
     Лаунчеры, которые поддерживают прозрачность, покажут сквозь неё обои — как у виджетов. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#2EFFFFFF"
                android:endX="108"
                android:endY="108"
                android:startColor="#73FFFFFF"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- мягкий блик в верхней части -->
    <path android:pathData="M0,0h108v54h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#00FFFFFF"
                android:endX="54"
                android:endY="54"
                android:startColor="#33FFFFFF"
                android:startX="54"
                android:startY="18"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
